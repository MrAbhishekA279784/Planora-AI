# ===================================================================
# PLANORA AI — PHASE 1 ENVIRONMENT CONFIGURATION
# ===================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime.
APP_URL="MY_APP_URL"

# -------------------------------------------------------------------
# FIREBASE CLIENT CONFIGURATION (VITE_)
# -------------------------------------------------------------------
VITE_FIREBASE_API_KEY="AIzaSyDemoPlaceholderKey1234567890"
VITE_FIREBASE_AUTH_DOMAIN="planora-ai.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="planora-ai"
VITE_FIREBASE_STORAGE_BUCKET="planora-ai.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# -------------------------------------------------------------------
# FIREBASE ADMIN SDK CONFIGURATION (SERVER-SIDE ONLY)
# -------------------------------------------------------------------
# Stringified JSON object containing Firebase service account credentials.
# NEVER expose this variable to client-side code (do NOT prefix with VITE_).
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"planora-ai","private_key_id":"123","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@planora-ai.iam.gserviceaccount.com"}'

# -------------------------------------------------------------------
# SUPABASE POSTGRESQL CONFIGURATION (SERVER-SIDE ONLY)
# -------------------------------------------------------------------
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# -------------------------------------------------------------------
# GOOGLE MAPS PLATFORM CONFIGURATION
# -------------------------------------------------------------------
# Client-side API key for Google Maps JavaScript API
VITE_GOOGLE_MAPS_API_KEY="AIzaSyYourClientGoogleMapsKeyHere"

# Server-side API key for Google Places API (New) proxy
GOOGLE_MAPS_API_KEY="AIzaSyYourServerGooglePlacesKeyHere"

# -------------------------------------------------------------------
# SERVER CONFIGURATION
# -------------------------------------------------------------------
PORT=3000
NODE_ENV="development"
